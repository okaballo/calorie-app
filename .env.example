# Supabase (Cloud Sync). Copy this file to .env.local and fill in both values from
# Supabase dashboard > Project Settings > API. Without them the app runs local-only.
#
# The anon / publishable key is designed to be public (it ships inside the app);
# Row Level Security in supabase/schema.sql is what protects the data.
# NEVER put the service_role / secret key in any VITE_ variable: Vite builds
# every VITE_ value into the public JavaScript.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
